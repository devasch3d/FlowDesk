{
  "name": "flowdesk-desktop",
  "version": "0.1.0",
  "description": "FlowDesk 桌面客户端（Electron 壳，M9）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --win portable",
    "pack:install": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.flowdesk.app",
    "productName": "FlowDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/flowdesk-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
