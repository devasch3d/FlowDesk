{
  "name": "flowdesk-desktop",
  "version": "0.2.3",
  "description": "FlowDesk 桌面客户端（Electron 壳，M9）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --win zip",
    "pack:install": "electron-builder --win nsis",
    "pack:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.flowdesk.app",
    "productName": "FlowDesk",
    "afterPack": "afterPack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/flowdesk-backend",
        "to": "backend"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  }
}
